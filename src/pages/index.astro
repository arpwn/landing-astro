---
import Layout from "../layouts/Layout.astro"
import Hero from "../components/Hero.astro"
---

<Layout title="DevLaunch - Lanza tu proyecto web">

  <!-- Hero principal -->
  <Hero />

  <!-- Sección de Features -->
  <section id="features" class="mt-24 text-center">

    <h2 class="text-3xl font-bold mb-12">
      Todo lo que necesitas para lanzar rápido
    </h2>

    <div class="grid md:grid-cols-3 gap-8">

      <div class="p-6 bg-white rounded-xl shadow">
        <h3 class="font-bold mb-2">Deploy instantáneo</h3>
        <p class="text-gray-600">
          Publica tu proyecto con un solo clic.
        </p>
      </div>

      <div class="p-6 bg-white rounded-xl shadow">
        <h3 class="font-bold mb-2">APIs listas</h3>
        <p class="text-gray-600">
          Autenticación, base de datos y servicios integrados.
        </p>
      </div>

      <div class="p-6 bg-white rounded-xl shadow">
        <h3 class="font-bold mb-2">Dashboard simple</h3>
        <p class="text-gray-600">
          Administra tus proyectos fácilmente.
        </p>
      </div>

    </div>

  </section>

  <!-- Call To Action principal -->
  <section id="cta" class="mt-28 text-center">

    <h2 class="text-4xl font-bold mb-6">
      Empieza a construir hoy
    </h2>

    <p class="text-gray-600 mb-8 max-w-lg mx-auto">
      Crea tu cuenta y lanza tu primer proyecto en minutos con DevLaunch.
    </p>

    <button class="bg-black text-white px-10 py-4 rounded-xl hover:scale-105 transition shadow-lg">
      Crear cuenta gratis
    </button>

  </section>

</Layout>