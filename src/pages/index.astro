---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
const services = [
  { number:'01',name:'Una página que presenta.',type:'LANDING PAGE',description:'Tu oferta, sus beneficios y un camino directo al contacto. Para lanzar un servicio o dar a conocer una idea.',tags:['Mensaje principal','Diseño adaptable','Contacto'] },
  { number:'02',name:'Un sitio que cuenta más.',type:'SITIO DE NEGOCIO',description:'Espacio para tus servicios, tu historia y las preguntas de tus clientes. Cada sección tiene un propósito.',tags:['Estructura de contenido','Servicios','Preguntas frecuentes'] },
  { number:'03',name:'Trabajo que habla por ti.',type:'PORTAFOLIO',description:'Una selección de proyectos con el contexto que necesitan. Para profesionales y estudios que quieren mostrar su trabajo.',tags:['Selección de proyectos','Casos de trabajo','Perfil profesional'] },
];

import T from "../components/Localized.astro";
---

<Layout title="DevLaunch — Una web clara para tu negocio"><Hero/><div class="principles wrap"><span><T text="CLARIDAD ANTES QUE RUIDO."/></span><div><span><T text="Contenido con intención"/></span><i>✳</i><span><T text="Diseño para cualquier pantalla"/></span><i>✳</i><span><T text="Acciones que funcionan"/></span></div></div><section id="servicios" class="section wrap" aria-labelledby="services-title"><div class="section-heading"><div><p class="eyebrow"><T text="01 / QUÉ HACEMOS"/></p><h2 id="services-title"><T text="La web que tu idea necesita."/></h2></div><p><T text="El punto de partida depende de lo que quieres comunicar y de lo que tu visitante necesita hacer."/></p></div><div class="services">{services.map(service=><article class="service"><span class="service-number">{service.number} ↗</span><p class="eyebrow"><T text={service.type}/></p><h3><T text={service.name}/></h3><p><T text={service.description}/></p><ul>{service.tags.map(tag=><li><T text={tag}/></li>)}</ul></article>)}</div></section><section id="proceso" class="process-section"><div class="section wrap"><div class="section-heading"><div><p class="eyebrow"><T text="02 / EL PROCESO"/></p><h2><T text="De una conversación"/><br/><T text="a una web con dirección."/></h2></div><p><T text="Primero entendemos el negocio. Después damos forma a la experiencia y revisamos cómo funciona."/></p></div><ol class="process-list"><li><span>01</span><div><h3><T text="Entender y enfocar"/></h3><p><T text="Definimos el objetivo, la audiencia y el contenido disponible. Acordamos qué debe resolver el sitio."/></p></div><small><T text="ENTREGABLE / BRIEF"/></small></li><li><span>02</span><div><h3><T text="Diseñar y construir"/></h3><p><T text="Organizamos el contenido, damos forma a la interfaz y adaptamos el sitio a distintas pantallas."/></p></div><small><T text="ENTREGABLE / VISTA PREVIA"/></small></li><li><span>03</span><div><h3><T text="Revisar y publicar"/></h3><p><T text="Probamos la navegación, los enlaces y los formularios. Ajustamos el contenido antes de compartir el sitio."/></p></div><small><T text="ENTREGABLE / SITIO WEB"/></small></li></ol></div></section><section id="brief" class="section wrap brief-section" aria-labelledby="brief-title"><div class="brief-intro"><p class="eyebrow"><T text="03 / TU SIGUIENTE PASO"/></p><h2 id="brief-title"><T text="Empecemos por"/><br/><T text="una buena pregunta."/></h2><p><T text="¿Qué necesitas que tu sitio haga por tu negocio? Arma un brief con lo esencial y descárgalo para tu primera conversación."/></p><div class="brief-tip"><span>↗</span><p><T text="Este configurador crea un documento en tu dispositivo. Puedes revisarlo y compartirlo cuando quieras."/></p></div></div><div class="brief-card"><form id="brief-form"><label for="business"><T text="Nombre de tu negocio o proyecto"/></label><input id="business" name="business" maxlength="100" placeholder="Ej. Estudio Norte" data-placeholder-key="Ej. Estudio Norte" required/><div class="form-row"><div><label for="site-type"><T text="Qué quieres construir"/></label><select id="site-type" name="type"><option value="Landing page" data-option-key="Landing page">Landing page</option><option value="Sitio de negocio" data-option-key="Sitio de negocio">Sitio de negocio</option><option value="Portafolio" data-option-key="Portafolio">Portafolio</option></select></div><div><label for="goal"><T text="Objetivo principal"/></label><select id="goal" name="goal"><option value="Recibir consultas" data-option-key="Recibir consultas">Recibir consultas</option><option value="Presentar un servicio" data-option-key="Presentar un servicio">Presentar un servicio</option><option value="Mostrar mi trabajo" data-option-key="Mostrar mi trabajo">Mostrar mi trabajo</option></select></div></div><label for="message"><T text="Qué te gustaría contar"/></label><textarea id="message" name="message" rows="3" maxlength="2000" placeholder="Tu audiencia, tus servicios y lo que ya tienes preparado…" data-placeholder-key="Tu audiencia, tus servicios y lo que ya tienes preparado…"></textarea><div class="brief-preview"><p class="eyebrow"><T text="TU PUNTO DE PARTIDA"/></p><p id="brief-preview-text"><T text="Una landing page para recibir consultas."/></p></div><div class="form-actions"><button class="button primary" type="submit"><T text="Descargar mi brief"/> <span>↓</span></button><button class="reset-button" type="reset"><T text="Empezar de nuevo"/></button></div><p id="brief-status" class="form-status" role="status" aria-live="polite"></p></form></div></section><section class="section wrap faq" aria-labelledby="faq-title"><div><p class="eyebrow"><T text="ANTES DE EMPEZAR"/></p><h2 id="faq-title"><T text="Dudas frecuentes."/></h2></div><div><details><summary><T text="¿Qué necesito tener preparado?"/><span>+</span></summary><p><T text="Una idea del objetivo, información de tu negocio y cualquier referencia visual o contenido que ya tengas. El brief te ayuda a ordenar ese punto de partida."/></p></details><details><summary><T text="¿Cuánto tarda un proyecto?"/><span>+</span></summary><p><T text="Depende de su alcance y del contenido disponible. La primera conversación sirve para acordar entregables y un calendario que se pueda cumplir."/></p></details><details><summary><T text="¿Este sitio es un servicio en operación?"/><span>+</span></summary><p><T text="DevLaunch es un concepto de estudio web creado como proyecto de portafolio. El configurador funciona y genera un brief descargable; no realiza contrataciones ni envía formularios."/></p></details></div></section></Layout>

<script>
import { getLanguage, t } from '../scripts/language';
import { buildBrief } from '../lib/brief';
const form = document.querySelector<HTMLFormElement>('#brief-form')!;
const business = document.querySelector<HTMLInputElement>('#business')!;
const type = document.querySelector<HTMLSelectElement>('#site-type')!;
const goal = document.querySelector<HTMLSelectElement>('#goal')!;
const message = document.querySelector<HTMLTextAreaElement>('#message')!;
const preview = document.querySelector<HTMLElement>('#brief-preview-text')!;
const status = document.querySelector<HTMLElement>('#brief-status')!;
function updatePreview() { preview.textContent=t('{0}: {1} para {2}.',[business.value.trim()||t('Tu proyecto'),t(type.value).toLowerCase(),t(goal.value).toLowerCase()]);status.textContent='';business.setCustomValidity(''); }
form.addEventListener('input',updatePreview);
form.addEventListener('reset',()=>requestAnimationFrame(updatePreview));
document.addEventListener('app-language-change',updatePreview);
updatePreview();
form.addEventListener('submit',event=>{event.preventDefault();if(!business.value.trim()){business.setCustomValidity(t('Escribe el nombre de tu proyecto.'));business.reportValidity();return;}business.setCustomValidity('');const brief=buildBrief({business:business.value,type:type.value,goal:goal.value,message:message.value},getLanguage());const url=URL.createObjectURL(new Blob([brief],{type:'text/plain;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download=getLanguage()==='en'?'project-brief.txt':'brief-proyecto-web.txt';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);status.textContent=t('Brief descargado. Ya puedes revisarlo y compartirlo.');});
</script>
