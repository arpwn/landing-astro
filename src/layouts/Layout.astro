---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
const { title } = Astro.props;
const description = 'DevLaunch: concepto de estudio web para negocios. Explora el proceso y prepara un brief descargable para tu siguiente sitio.';
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f7f6f2"/><title>{title}</title><link rel="canonical" href="https://landing-astro-bay.vercel.app/"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="es_MX"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head><body><a class="skip-link" href="#main">Saltar al contenido</a><Navbar/><main id="main"><slot/></main><footer class="site-footer wrap"><a class="brand" href="#inicio"><span>◧</span>DevLaunch</a><p>Concepto de estudio digital · Proyecto de portafolio de Armando Gtz.</p><a href="https://github.com/arpwn/landing-astro" target="_blank" rel="noreferrer">Ver código ↗</a></footer></body></html>
