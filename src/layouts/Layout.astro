---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
const { title } = Astro.props
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
  </head>

  <body class="bg-gradient-to-b from-white to-gray-100 text-gray-900 scroll-smooth">

    <!-- Navbar fijo -->
    <Navbar />

    <!-- Contenido principal -->
    <main class="max-w-4xl mx-auto p-10 pt-32">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="text-center p-6 text-gray-500 dark:text-gray-400 mt-20">
      © 2026 DevLaunch
    </footer>

  </body>
</html>